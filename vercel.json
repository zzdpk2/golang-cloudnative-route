{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/reset.mjs": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/reset",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
